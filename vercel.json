{
    "rewrites": [
        { "source": "/EngineerNetwork", "destination": "/EngineerNetwork.html" },
        { "source": "/EngineerNetwork/", "destination": "/EngineerNetwork.html" },
        { "source": "/PE", "destination": "/PE.html" },
        { "source": "/PE/", "destination": "/PE.html" },
        { "source": "/TSE", "destination": "/TSE.html" },
        { "source": "/TSE/", "destination": "/TSE.html" },
        { "source": "/ECEN", "destination": "/ECEN.html" },
        { "source": "/ECEN/", "destination": "/ECEN.html" },
        { "source": "/CSS", "destination": "/CSS.html" },
        { "source": "/CSS/", "destination": "/CSS.html" },
        { "source": "/TEFL", "destination": "/TEFL.html" },
        { "source": "/TEFL/", "destination": "/TEFL.html" },
        { "source": "/CRE", "destination": "/credentials.html" },
        { "source": "/CRE/", "destination": "/credentials.html" },
        { "source": "/credentials", "destination": "/credentials.html" },
        { "source": "/credentials/", "destination": "/credentials.html" }
